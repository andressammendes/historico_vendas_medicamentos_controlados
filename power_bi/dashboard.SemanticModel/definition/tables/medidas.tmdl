table medidas
	lineageTag: 9d8a2e01-9746-4955-8edb-3c83fd4d0ee6

	measure 'Qnt. Medicamentos Manipulados' = DISTINCTCOUNT(f_manipulados[principio_ativo])
		formatString: #,0
		displayFolder: manipulados
		lineageTag: 64ceef9d-3758-4c5f-aebe-0bd2fb1e2883

	measure 'Qnt. Medicamentos Industrializados' = DISTINCTCOUNT(f_industrializados[principio_ativo])
		formatString: #,0
		displayFolder: industrializados
		lineageTag: 9ed37e43-f3ae-4958-8b5f-62a66ef42c6e

	measure 'Total Vendido Industrializados' = SUM(f_industrializados[qt_vendida])
		displayFolder: industrializados
		lineageTag: 680a9bfe-524f-40dd-ab6e-790aaa5fdf8c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Vendido Manipulados' = SUM(f_manipulados[qt_ativo_por_unidade_farmacotec])
		displayFolder: manipulados
		lineageTag: b7c3b691-f4e1-4cb6-86b6-5dcc18c4dea1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
