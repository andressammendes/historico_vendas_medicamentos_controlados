table medidas
	lineageTag: 9d8a2e01-9746-4955-8edb-3c83fd4d0ee6

	measure 'Princípios Ativos' = ```
			
			 var principio_ativo_m = DISTINCTCOUNT(f_manipulados[principio_ativo])
			 var principio_ativo_i = DISTINCTCOUNT(f_industrializados[principio_ativo])
			 return
			 principio_ativo_i+principio_ativo_m
			```
		formatString: #,0
		lineageTag: 64ceef9d-3758-4c5f-aebe-0bd2fb1e2883

	measure 'Total de Receitas' = ```
			
			 var total_receitas_m = SUM(f_manipulados[qt_vendida(receitas)])
			 var total_receitas_i = SUM(f_industrializados[qtd_registros(receitas)])
			 return
			 total_receitas_m+total_receitas_i
			```
		formatString: #,0
		lineageTag: b7c3b691-f4e1-4cb6-86b6-5dcc18c4dea1

	measure 'Total de Princípios Ativos' = ```
			
			 var ativo_vendido_m = SUM(f_manipulados[qt_ativo_vendido])
			 var ativo_vendido_i = SUM(f_industrializados[qt_vendida(unidades)])
			 return
			 ativo_vendido_i+ativo_vendido_m
			```
		lineageTag: fd22531c-48fd-4acc-a3b4-ac5c781f748c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Estado Maior Volume' = ```
			
			TOPN(
			    1, 
			    VALUES('dim_municipio_uf'[uf]), 
			    [Total de Receitas], 
			    DESC
			)
			```
		displayFolder: home
		lineageTag: 9dabe554-2513-4d23-b2d7-048efaa14d33

	measure '% Prescrições CRM industrializados' = ```
			
			VAR ReceitasCRM = 
			    CALCULATE(
			        SUM(f_industrializados[qtd_registros(receitas)]), 
			        'conselho_prescritor'[conselho_prescritor] = "CRM"
			    )
			VAR TotalReceitas = SUM(f_industrializados[qtd_registros(receitas)])
			RETURN
			DIVIDE(ReceitasCRM, TotalReceitas, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: home
		lineageTag: 4332a297-9cdb-477a-a95e-bf82c1dc4333

	measure '% Prescrições CRM manipulados' = ```
			
			VAR ReceitasCRM = 
			    CALCULATE(
			       SUM(f_manipulados[qt_vendida(receitas)]),
			        'conselho_prescritor'[conselho_prescritor] = "CRM"
			    )
			VAR TotalReceitas = SUM(f_manipulados[qt_vendida(receitas)])
			RETURN
			DIVIDE(ReceitasCRM, TotalReceitas, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: home
		lineageTag: 7ce26455-500b-49e4-bb92-d2361be58d98

	measure '% Share Industrializados' =
			
			VAR TotalIndustrializados = SUM(f_industrializados[qtd_registros(receitas)])
			VAR TotalGeral =  [Total de Receitas]
			RETURN
			DIVIDE(TotalIndustrializados, TotalGeral, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: home
		lineageTag: 5c42607c-7806-4997-af0b-8b77ed5b7c0c

	measure '% Dif Princípios Ativos Industrializados' =
			
			VAR QtdIndustrializados = DISTINCTCOUNT(f_industrializados[principio_ativo])
			VAR QtdManipulados = DISTINCTCOUNT(f_manipulados[principio_ativo])
			RETURN
			DIVIDE(QtdIndustrializados - QtdManipulados, QtdManipulados, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: home
		lineageTag: c09505d0-b662-451a-8eda-62b2cd34de42

	column Column
		isHidden
		formatString: 0
		lineageTag: a1fe69b7-68d4-4d36-bcb9-5960f47c1d3e
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition medidas = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 220554aed7e841fab78709b97cf1e1b4

