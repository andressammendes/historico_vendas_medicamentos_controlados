table 'medidas visual'
	lineageTag: 7191437f-8665-4e87-a42b-a1bde041eae5

	measure 'Cor_Dinamica Fundo' =
			
			VAR vSelecao = SELECTEDVALUE(tipo_apresentacao[descricao])
			RETURN
			    SWITCH(
			        TRUE(),
			        vSelecao = "Manipulados", "#0B353A",
			        vSelecao = "Industrializados", "#0A1C40",
			        "#0B353A"
